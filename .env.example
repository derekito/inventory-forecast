# Store handle from admin URL: https://admin.shopify.com/store/THIS_PART (e.g. naked-armor)
NEXT_PUBLIC_SHOPIFY_STORE=naked-armor

# Required: Admin API access token. Use your custom app's "API secret key" as this value.
# (The "API key" is not used for Admin API requests.)
SHOPIFY_ACCESS_TOKEN=your_access_token_here

# Optional: Max products to fetch (default 500, max 1000). Reduces load with large catalogs.
# NEXT_PUBLIC_MAX_PRODUCTS=500
